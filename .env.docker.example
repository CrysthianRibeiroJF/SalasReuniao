# Configuração do Docker Compose (produção). Copie para ".env" na raiz do projeto:
#     cp .env.docker.example .env          (PowerShell: Copy-Item .env.docker.example .env)
# O Compose lê este arquivo para montar o docker-compose.yml e repassa as variáveis ao container
# "app". NUNCA versione o .env: ele guarda segredos.
#
# Este modelo é público: NENHUM valor secreto vem preenchido. Gere os seus (somente letras,
# números, "-" e "_", seguros dentro de URLs) com:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
#     (ou: openssl rand -hex 32)

# ------------------------------------------------------------------ obrigatórias
# Senha do usuário "agenda" do PostgreSQL. Use apenas letras, números, "-" e "_" (ela entra na URL
# de conexão). Definida na PRIMEIRA subida: depois, trocar aqui não muda a senha já gravada no banco.
# Vazia, o compose não sobe.
POSTGRES_PASSWORD=

# Segredo que assina os tokens de login: pelo menos 32 caracteres aleatórios (em produção a
# aplicação não sobe com menos). Trocá-lo derruba todas as sessões abertas (todos entram de novo).
# Vazio, o compose não sobe.
AGENDA_JWT_SECRET=

# ------------------------------------------------------------------ administrador inicial
# Criado na primeira subida (init-db) somente se o banco ainda não tiver nenhum usuário. Duas
# opções:
#   a) defina aqui uma senha forte e exclusiva: 12 caracteres ou mais, diferente do usuário, que
#      não seja de exemplo/demonstração (admin123, senha123...) nem comece com "troque". Senha
#      fraca é recusada: o container para com a mensagem no log (docker compose logs app).
#      Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(16))"
#   b) deixe AGENDA_BOOTSTRAP_ADMIN_PASSWORD vazio, suba o sistema e crie o administrador
#      digitando a senha no terminal (ela não fica gravada em arquivo):
#        docker compose exec app python -m app.cli create-user --username admin --name "Administrador" --role ADMIN
# Depois do primeiro acesso, apague a senha daqui: ela não é mais usada.
AGENDA_BOOTSTRAP_ADMIN_USERNAME=admin
AGENDA_BOOTSTRAP_ADMIN_PASSWORD=
AGENDA_BOOTSTRAP_ADMIN_NAME=Administrador

# ------------------------------------------------------------------ publicação
# Porta do host onde a aplicação fica acessível (http://servidor:8000).
HTTP_PORT=8000
# Interface do host. Use 127.0.0.1 quando houver um proxy reverso (nginx/IIS) na mesma máquina,
# para que a porta 8000 não fique exposta na rede.
HTTP_BIND=0.0.0.0

# ------------------------------------------------------------------ processo web (entrypoint)
# Processos do uvicorn. Mais de 1 exige Redis (o compose já sobe e configura o Redis).
WEB_CONCURRENCY=2
# 1 liga o log de acesso por requisição (o token do WebSocket é mascarado no log da aplicação).
UVICORN_ACCESS_LOG=0
# IPs do proxy reverso autorizados a informar X-Forwarded-For/Proto. "*" confia em qualquer origem:
# só é seguro se a porta 8000 não estiver acessível diretamente pela rede (quem alcança a porta
# poderia forjar o IP e escapar do limite de tentativas de login por IP).
FORWARDED_ALLOW_IPS=*

# ------------------------------------------------------------------ aplicação (prefixo AGENDA_)
# Link do sistema de chamados; {ticket} é substituído pelo número. Vazio = número sem link.
AGENDA_TICKET_URL_TEMPLATE=

# Duração da sessão (minutos). Padrão: 720 = um turno de 12 h.
AGENDA_JWT_EXPIRE_MINUTES=720

# Regras de calendário (padrões do sistema; descomente para mudar).
# AGENDA_TIMEZONE=America/Sao_Paulo
# AGENDA_DAY_START=08:00
# AGENDA_DAY_END=19:00
# AGENDA_MORNING_END=12:00
# AGENDA_AFTERNOON_START=13:00
# AGENDA_SLOT_MINUTES=30
# AGENDA_WORK_DAYS=[0,1,2,3,4]
# AGENDA_LOCK_TTL_SECONDS=120

# Limite de tentativas de login (padrões; descomente para mudar): 5 falhas seguidas, com no máximo
# 15 min entre elas, bloqueiam o usuário (e o IP) por 1 min; as falhas seguintes, por 5 e 15 min.
# AGENDA_LOGIN_MAX_FAILURES=5
# AGENDA_LOGIN_FAILURE_WINDOW_SECONDS=900
# AGENDA_LOGIN_BLOCK_SECONDS=[60,300,900]

# Prazo (segundos) do teste do banco em GET /api/health; estourou = 503.
# AGENDA_HEALTH_DB_TIMEOUT_SECONDS=3

# Origens de OUTROS domínios autorizadas a chamar a API (CORS). A SPA é servida pela própria
# aplicação, na mesma origem, e não precisa disso: deixe vazio ([]). Se outra aplicação precisar,
# liste os endereços: ["https://intranet.empresa.com.br"]
AGENDA_CORS_ORIGINS=[]

# AGENDA_DATABASE_URL, AGENDA_REDIS_URL, AGENDA_ENV e AGENDA_FRONTEND_DIST são definidas pelo
# docker-compose.yml/Dockerfile a partir dos valores acima: não as defina aqui.
