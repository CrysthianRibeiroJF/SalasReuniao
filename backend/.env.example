# Copie para backend/.env e ajuste. Todas as variáveis têm prefixo AGENDA_.
AGENDA_ENV=development
AGENDA_DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5433/agenda
# Vazio = travas e eventos em memória (apenas UMA instância do backend). Produção: redis://redis:6379/0
AGENDA_REDIS_URL=
# Em produção use um valor aleatório longo (ex.: python -c "import secrets; print(secrets.token_urlsafe(48))")
AGENDA_JWT_SECRET=dev-only-insecure-secret-change-me-0123456789
AGENDA_JWT_EXPIRE_MINUTES=720

AGENDA_TIMEZONE=America/Sao_Paulo
AGENDA_DAY_START=08:00
AGENDA_DAY_END=19:00
AGENDA_MORNING_END=12:00
AGENDA_AFTERNOON_START=13:00
AGENDA_SLOT_MINUTES=30
AGENDA_WORK_DAYS=[0,1,2,3,4]
AGENDA_LOCK_TTL_SECONDS=120

# Link do sistema de chamados; {ticket} é substituído pelo número
AGENDA_TICKET_URL_TEMPLATE=https://chamados.example.com/ticket/{ticket}

AGENDA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Se definido, o backend serve o build do frontend em "/"
AGENDA_FRONTEND_DIST=

# Primeiro administrador criado por `python -m app.cli init-db` quando não há usuários
AGENDA_BOOTSTRAP_ADMIN_USERNAME=admin
AGENDA_BOOTSTRAP_ADMIN_PASSWORD=admin123

# Credenciais de DEMONSTRAÇÃO criadas por `python -m app.cli seed-demo` (somente AGENDA_ENV=development;
# nunca use em produção — ver app/seed.py):
#   admin / admin123 (ADMIN) · recepcao1 / recepcao123 (RECEPTIONIST) · recepcao2 / recepcao123 (RECEPTIONIST)
